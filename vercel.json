{
  "version": 2,
  "builds": [
    { "src": "index.js",        "use": "@vercel/node" },
    { "src": "instaindex.js",   "use": "@vercel/node" },
    { "src": "figma.js",        "use": "@vercel/node" },
    { "src": "pdf-product-association.js", "use": "@vercel/node" },
    { "src": "shopify.js",      "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/pdf/associate", "dest": "pdf-product-association.js" },
    { "src": "/api/figma/(.*)",    "dest": "figma.js" },
    { "src": "/api/instagram/(.*)", "dest": "instaindex.js" },
    { "src": "/api/linkedin/(.*)", "dest": "index.js" },
    { "src": "/auth/linkedin/(.*)", "dest": "index.js" },
    { "src": "/linkedin/(.*)",     "dest": "index.js" },
    { "src": "/shopify/(.*)",      "dest": "shopify.js" },
    { "src": "/(.*)",              "dest": "index.js" }
  ]
}