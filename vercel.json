{
  "version": 2,
  "builds": [
    { "src": "api/linkedin.js", "use": "@vercel/node" },
    { "src": "api/instagram.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/instagram/(.*)", "dest": "api/instagram.js" },
    { "src": "/api/linkedin/(.*)", "dest": "api/linkedin.js" },
    { "src": "/auth/linkedin/(.*)", "dest": "api/linkedin.js" },
    { "src": "/linkedin/(.*)", "dest": "api/linkedin.js" },
    { "src": "/(.*)", "dest": "api/linkedin.js" }
  ]
}